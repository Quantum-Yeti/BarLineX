<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Decode Screen -->
    <style name="DecodeScreen">
        <item name="android:background">#1A1A1D</item>
    </style>

    <!-- Screen Header -->
    <style name="DecodeHeader">
        <item name="android:textColor">#F5F5F5</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DecodeStatus">
        <item name="android:textColor">#A9BDFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Scanner Card -->
    <style name="DecodeScannerCard">
        <item name="cardBackgroundColor">#121212</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#303034</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Result Content Card -->
    <style name="DecodeContentCard">
        <item name="cardBackgroundColor">#1C1C1E</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#303034</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Section Labels -->
    <style name="DecodeSectionLabel">
        <item name="android:textColor">#A1A1AA</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Result Text -->
    <style name="DecodeResultTitle">
        <item name="android:textColor">#F5F5F5</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DecodeResultSubtitle">
        <item name="android:textColor">#A1A1AA</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DecodeResultContent">
        <item name="android:textColor">#F5F5F5</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Detail Rows -->
    <style name="DecodeDetailLabel">
        <item name="android:textColor">#A1A1AA</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DecodeDetailValue">
        <item name="android:textColor">#F5F5F5</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Expandable Sections -->
    <style name="DecodeExpandableHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="DecodeExpandableTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#F5F5F5</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DecodeExpandableContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- Action Buttons -->
    <style name="DecodeSecondaryButton"
        parent="Widget.Material3.Button">
        <item name="android:layout_height">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#F5F5F5</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">#232326</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">#303034</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="DecodePrimaryButton"
        parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#121212</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#8B9EFF</item>
        <item name="cornerRadius">12dp</item>
    </style>

</resources>