<resources>

    <style name="Theme.BarLineX" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#121212</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">#121212</item>

        <item name="colorSurface">@color/background_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="colorSurfaceVariant">@color/background_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorOutline">@color/border_default</item>
        <item name="colorOutlineVariant">@color/border_subtle</item>

        <item name="colorError">#F87171</item>

        <item name="android:statusBarColor">@color/background_main</item>
        <item name="android:navigationBarColor">@color/background_main</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background_main</item>
        <item name="android:colorAccent">@color/brand_primary</item>
    </style>

    <!-- Toolbar typography -->
    <style name="BarLineXToolbarTitle"
        parent="TextAppearance.Material3.TitleLarge">

        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">#F4F6FF</item>
        <item name="android:includeFontPadding">false</item>

    </style>

    <style name="Theme.BarLineX.Starting" parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/background_main</item>

        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <item name="postSplashScreenTheme">@style/Theme.BarLineX</item>

    </style>

</resources>