<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/decodeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1D">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/decodeHeader"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Decode Barcode"
            android:textColor="#F5F5F5"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDecodeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY"
            android:textColor="#A9BDFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <!-- Main scanner workspace -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardScanner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#121212"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="#303034"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/decodeHeader"
        app:layout_constraintBottom_toTopOf="@id/decodeActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Live camera preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/decodeCameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <me.theoria.barlinex.ui.widget.ScannerOverlay
            android:id="@+id/scannerOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Initial scanner placeholder -->
        <LinearLayout
            android:id="@+id/scannerPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_scan_number"
                app:tint="#8B9EFF"
                android:contentDescription="Barcode scanner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Ready to scan"
                android:textColor="#F5F5F5"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Point your camera at a barcode or QR code."
                android:textColor="#A1A1AA"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- Decoded result -->
        <LinearLayout
            android:id="@+id/decodeResultPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121212"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- Result heading -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_scan_number"
                    app:tint="#8B9EFF"
                    android:contentDescription="Successful scan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Barcode detected"
                        android:textColor="#F5F5F5"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Successfully decoded"
                        android:textColor="#A1A1AA"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textDecodedFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#232B43"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:text="QR CODE"
                    android:textColor="#A9BDFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Decoded barcodeContent -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="DECODED CONTENT"
                android:textColor="#A1A1AA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="#1C1C1E"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#303034"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/textDecodedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:padding="16dp"
                    android:textColor="#F5F5F5"
                    android:textSize="15sp"
                    android:textIsSelectable="true"
                    android:maxLines="5"
                    android:ellipsize="end" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Content actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCopyResult"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Copy"
                    android:textAllCaps="false"
                    android:textColor="#F5F5F5"
                    android:textSize="13sp"
                    app:backgroundTint="#232326"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="#A9BDFF"
                    app:strokeColor="#303034"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonShareResult"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Share"
                    android:textAllCaps="false"
                    android:textColor="#F5F5F5"
                    android:textSize="13sp"
                    app:backgroundTint="#232326"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_share"
                    app:iconTint="#A9BDFF"
                    app:strokeColor="#303034"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- Barcode details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="BARCODE DETAILS"
                android:textColor="#A1A1AA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="#1C1C1E"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#303034"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <!-- Barcode type -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Barcode type"
                            android:textColor="#A1A1AA"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textDecodedType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2D"
                            android:textColor="#F5F5F5"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#303034" />

                    <!-- Content length -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Content length"
                            android:textColor="#A1A1AA"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textDecodedLength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 characters"
                            android:textColor="#F5F5F5"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#303034" />

                    <!-- Check digit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Check digit"
                            android:textColor="#A1A1AA"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textDecodedCheckDigit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not applicable"
                            android:textColor="#F5F5F5"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#303034" />

                    <!-- Scan time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Scanned"
                            android:textColor="#A1A1AA"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textDecodedTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Just now"
                            android:textColor="#F5F5F5"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Scan again -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonScanAgain"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Scan Again"
                android:textAllCaps="false"
                android:textColor="#121212"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#8B9EFF"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom actions -->
    <LinearLayout
        android:id="@+id/decodeActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/decodeBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGallery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Choose from Gallery"
            android:textAllCaps="false"
            android:textColor="#F5F5F5"
            android:textSize="15sp"
            app:backgroundTint="#232326"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_history"
            app:iconTint="#A9BDFF"
            app:strokeColor="#303034"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/decodeBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1D"
        app:itemIconTint="@color/brand_primary"
        app:itemTextColor="@color/brand_primary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_navigation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
