<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/decodeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fitsSystemWindows="true">

    <!-- App Header -->
    <include
        android:id="@+id/decodeAppHeader"
        layout="@layout/layout_app_header"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Decode Header -->
    <LinearLayout
        android:id="@+id/decodeHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/decodeAppHeader">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Decode Barcode"
            android:textColor="#F5F5F5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDecodeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY"
            android:textColor="#91A8FF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scanner / Result Workspace -->
    <FrameLayout
        android:id="@+id/cardScanner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_barcode_details"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/decodeHeader"
        app:layout_constraintBottom_toTopOf="@id/decodeActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            layout="@layout/layout_decode_scanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            layout="@layout/layout_decode_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Gallery Action -->
    <LinearLayout
        android:id="@+id/decodeActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/decodeBottomNavigation">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGallery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Choose from Gallery"
            android:textAllCaps="false"
            android:textColor="#F5F5F5"
            app:icon="@drawable/ic_history"
            app:iconTint="#91A8FF"
            app:backgroundTint="#1C1C1E"
            app:cornerRadius="14dp" />

    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/decodeBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        app:menu="@menu/menu_bottom_navigation"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>