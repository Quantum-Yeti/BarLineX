<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/historyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1020"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- App Header -->
    <LinearLayout
        android:id="@+id/historyToolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imageYeti"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_yeti"
            android:contentDescription="BarLineX Logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/textAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="BarLineX"
            android:textColor="#F4F6FF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:includeFontPadding="false" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to barcode generator"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            app:tint="#AFC0FF" />

    </LinearLayout>

    <!-- Page Heading -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="26dp">

        <TextView
            android:id="@+id/textHistoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Your Barcode Library"
            android:textColor="#F4F6FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/textHistorySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textAlignment="center"
            android:text="Access your previously generated codes."
            android:textColor="#929FB9"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Saved Barcode Section Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAVED BARCODES"
            android:textColor="#AAB7D4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:background="#26334A" />

        <TextView
            android:id="@+id/textHistoryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_history_badge"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:text="SAVED"
            android:textColor="#AFC0FF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/historyEmptyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_history_empty"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_yeti"
            android:scaleType="fitCenter"
            android:contentDescription="Empty barcode library" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Your library is empty"
            android:textColor="#F4F6FF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Generate your first barcode and save it here. Your saved codes will be ready whenever you need them."
            android:textColor="#929FB9"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

    <!-- Saved Barcode List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" />

</LinearLayout>