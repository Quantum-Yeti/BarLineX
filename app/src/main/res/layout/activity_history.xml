<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/historyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- BarLineX Header -->
    <LinearLayout
        android:id="@+id/historyToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#121212"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/barlinex_bigfoot_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_yeti" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textColor="#F5F5F5"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- History Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- Library Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/barcode_library"
                android:textColor="#F5F5F5"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHistoryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_format_badge"
                android:paddingHorizontal="11dp"
                android:paddingVertical="6dp"
                android:text="0 saved"
                android:textColor="#A9BDFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Search -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutHistorySearch"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search your library"
            app:boxBackgroundColor="#1C1C1E"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#303034"
            app:hintTextColor="#A1A1AA"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="#92929B"
            app:endIconMode="clear_text"
            app:endIconTint="#92929B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editHistorySearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#F5F5F5"
                android:textColorHint="#92929B"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Recently Saved Heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="RECENTLY SAVED"
                android:textColor="#A1A1AA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:background="#303034" />

        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/historyEmptyContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="#1C1C1E">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_qr_code"
                    app:tint="#8B9EFF" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Your library is empty"
                android:textColor="#F5F5F5"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHistoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Barcodes you save will appear here. Create your first barcode to get started."
                android:textColor="#92929B"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Saved Barcode List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom Navigation - Preserved -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1D"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#303034" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1A1D"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_bottom_navigation" />

    </LinearLayout>

</LinearLayout>
