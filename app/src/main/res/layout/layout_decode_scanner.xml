<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/decodeCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- Scanner Overlay -->
    <me.theoria.barlinex.ui.scanner.ScannerOverlay
        android:id="@+id/scannerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Zoom Controls -->
    <LinearLayout
        android:id="@+id/zoomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#CC121212"
        android:visibility="gone">

        <TextView
            android:id="@+id/textZoomLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="#F5F5F5"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="1.0"
            android:stepSize="0"
            android:valueFrom="1.0"
            android:valueTo="10.0"
            app:trackHeight="4dp"
            app:thumbRadius="7dp"
            app:thumbColor="#91A8FF"
            app:trackColorActive="#5278FF"
            app:trackColorInactive="#424242" />

        <Button
            android:id="@+id/buttonResetZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Reset Zoom"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- Scanner Placeholder -->
    <LinearLayout
        android:id="@+id/scannerPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#121212"
        android:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_scan_number"
            android:tint="#91A8FF"
            android:contentDescription="Scanner icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ready to scan"
            android:textColor="#F5F5F5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Point your camera at a barcode or QR code."
            android:textColor="#A1A1AA"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>