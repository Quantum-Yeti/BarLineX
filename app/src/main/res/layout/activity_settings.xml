<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/optionsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151518"
    android:fitsSystemWindows="true">

    <!-- App Header -->
    <include
        layout="@layout/layout_app_header" />

    <!-- Settings Header -->
    <include
        layout="@layout/layout_settings_header" />

    <!-- Settings Content -->
    <ScrollView
        android:id="@+id/optionsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121212"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/layout_settings_general" />

            <include layout="@layout/layout_settings_scanner" />

            <include layout="@layout/layout_settings_storage" />

            <include layout="@layout/layout_settings_feedback" />

            <include layout="@layout/layout_settings_about" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>