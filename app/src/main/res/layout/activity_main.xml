<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1D"
    android:orientation="vertical">

    <!-- App Header -->
    <include
        layout="@layout/layout_app_header" />

    <!-- Main Workspace -->
    <ScrollView
        android:id="@+id/createContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121212"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <!-- Live barcode preview -->
            <include
                layout="@layout/layout_main_barcode_preview" />

            <!-- Barcode settings -->
            <include
                layout="@layout/layout_main_barcode_options" />

        </LinearLayout>

    </ScrollView>



    <!-- Persistent save actions and navigation -->
    <include
        layout="@layout/layout_bottom_dock" />

</LinearLayout>
