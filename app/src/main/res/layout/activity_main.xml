<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101827"
    android:paddingTop="36dp">

    <!-- App Header -->
    <LinearLayout
        android:id="@+id/mainToolbar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="8dp"
        android:background="#101827">

        <ImageView
            android:id="@+id/imageYeti"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_yeti"
            android:contentDescription="@string/barly_bigfoot_logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/textAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/app_name"
            android:textColor="#F4F6FF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:includeFontPadding="false" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/buttonHistory"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/view_saved_barcodes"
            android:padding="12dp"
            android:src="@drawable/ic_history"
            android:scaleType="fitCenter"
            android:backgroundTint="@null"
            app:tint="#AFC0FF" />

    </LinearLayout>

    <!-- Scrollable Generator -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Live Preview -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/previewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#0B1020"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Preview heading -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Live Preview"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textPreviewFormat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_format_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:text="QR CODE"
                            android:textColor="#8EAFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Barcode canvas -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="16dp"
                        android:background="#FFFFFF"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/imagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Generated barcode preview"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/previewPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▦"
                                android:textColor="#9CA3AF"
                                android:textSize="42sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Your barcode will appear here"
                                android:textColor="#6B7280"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </FrameLayout>

                    <!-- Four preview actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:gravity="center"
                        android:layout_marginTop="12dp">

                        <!-- Share -->
                        <ImageButton
                            android:id="@+id/buttonShare"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/share_barcode"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_share"
                            app:tint="#8EAFFF" />

                        <!-- Save Image -->
                        <ImageButton
                            android:id="@+id/buttonSaveImage"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/save_barcode_image"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_save"
                            app:tint="#8EAFFF" />

                        <!-- Copy Text -->
                        <ImageButton
                            android:id="@+id/buttonCopyText"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy Text"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_copy"
                            app:tint="#8EAFFF" />

                        <!-- Enlarge -->
                        <ImageButton
                            android:id="@+id/buttonEnlarge"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Enlarge Barcode"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_enlarge"
                            app:tint="#8EAFFF" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="14dp"
                        android:background="#28334A" />

                    <!-- Barcode Content row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="#222D45"
                            android:gravity="center"
                            android:text="T"
                            android:textColor="#8EAFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Barcode Content"
                                android:textColor="#8F9BB1"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textPreviewContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="middle"
                                android:maxLines="1"
                                android:text="Enter text below"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/buttonCopyContent"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy barcode content"
                            android:padding="12dp"
                            android:src="@drawable/ic_copy"
                            app:tint="#8EAFFF" />

                    </LinearLayout>

                    <!-- Barcode information row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="#222D45"
                            android:gravity="center"
                            android:text="i"
                            android:textColor="#8EAFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Barcode Information"
                                android:textColor="#8F9BB1"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textPreviewInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="QR Code  •  0 characters"
                                android:textColor="#D4D9E5"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Content Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="CONTENT"
                android:textColor="#AAB7D4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contentInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter text or a value"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#182337"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#5278FF"
                app:hintTextColor="#9AA9C2"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_scan_number"
                app:endIconTint="#AFC0FF"
                app:endIconContentDescription="Scan number with camera"
                app:endIconCheckable="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#F4F6FF"
                    android:textColorHint="#78849E"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Barcode Format -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="BARCODE FORMAT"
                android:textColor="#AAB7D4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <RadioGroup
                android:id="@+id/formatGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioCode128"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_format_option"
                    android:buttonTint="#91A8FF"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:text="@string/code_128"
                    android:textColor="#F4F6FF"
                    android:textSize="14sp"
                    android:checked="true" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioQr"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_format_option"
                    android:buttonTint="#91A8FF"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:text="@string/qr_code"
                    android:textColor="#F4F6FF"
                    android:textSize="14sp"
                    android:checked="false" />

            </RadioGroup>

            <!-- Save Current Barcode -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGenerate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:text="@string/save_barcode"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:backgroundTint="#5278FF"
                app:icon="@drawable/ic_qr_code"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
