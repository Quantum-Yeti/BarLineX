<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/barcodePreviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1020"
    android:padding="22dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barcode Preview"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your generated barcode"
                android:textColor="#8290AA"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PREVIEW"
            android:textColor="#8EAFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_preview_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp" />

    </LinearLayout>

    <!-- Barcode Section Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:text="BARCODE IMAGE"
        android:textColor="#8290AA"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <!-- Barcode Canvas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_barcode_canvas"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imageBarcode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Enlarged barcode"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <!-- Barcode Information Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_barcode_details">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FORMAT"
            android:textColor="#8290AA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/textBarcodeFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/barcode_format"
            android:textColor="#8EAFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#26344D" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BARCODE CONTENT"
            android:textColor="#8290AA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/textBarcodeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Barcode barcodeContent"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Bottom Back Button -->
    <Button
        android:id="@+id/buttonBackBottom"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:text="Back"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#31558A" />

</LinearLayout>
