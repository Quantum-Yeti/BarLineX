<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/barcodePreviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- App Header -->
    <include
        layout="@layout/layout_app_header" />

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#121212"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBackBottom"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_back2"
            app:iconSize="26dp"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/textBarcodeFormat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/barcode_format"
            android:textColor="#F5F5F5"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSaveImage"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_save"
            app:iconSize="24dp"
            android:contentDescription="Save barcode image" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonShareBarcode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_share"
            app:iconSize="24dp"
            android:contentDescription="Share barcode" />

    </LinearLayout>

    <!-- Preview Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- Barcode Canvas -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@drawable/bg_barcode_canvas"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/imageBarcode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Enlarged barcode"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <!-- Section Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="About the Barcode"
                android:textColor="#F5F5F5"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Barcode Content Card -->
            <LinearLayout
                android:id="@+id/cardBarcodeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_barcode_details"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Content Header -->
                <LinearLayout
                    android:id="@+id/headerBarcodeContent"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonBarcode"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_barcode"
                        app:iconSize="32dp"
                        app:iconPadding="0dp"
                        android:contentDescription="Barcode content" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="Barcode Content"
                        android:textColor="#F5F5F5"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonContentDropDown"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_dropdown"
                        app:iconSize="32dp"
                        app:iconPadding="0dp"
                        android:contentDescription="Expand barcode content" />

                </LinearLayout>

                <!-- Content Body -->
                <LinearLayout
                    android:id="@+id/contentBarcodeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/textBarcodeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Untitled Barcode"
                        android:textColor="#92929B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textBarcodeContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="none"
                        android:gravity="start"
                        android:text="Barcode content"
                        android:textColor="#F5F5F5"
                        android:textSize="14sp"
                        android:textIsSelectable="true" />

                </LinearLayout>

            </LinearLayout>

            <!-- Barcode Information Card -->
            <LinearLayout
                android:id="@+id/cardBarcodeInformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_barcode_details"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Information Header -->
                <LinearLayout
                    android:id="@+id/headerBarcodeInformation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonInfo"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_info"
                        app:iconSize="32dp"
                        app:iconPadding="0dp"
                        android:contentDescription="Barcode information" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="Barcode Information"
                        android:textColor="#F5F5F5"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDropDown"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_dropdown"
                        app:iconSize="32dp"
                        app:iconPadding="0dp"
                        android:contentDescription="Expand barcode information" />

                </LinearLayout>

                <!-- Information Body -->
                <LinearLayout
                    android:id="@+id/contentBarcodeInformation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp">

                    <!-- Statistics Summary -->
                    <TextView
                        android:id="@+id/textBarcodeLength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 characters"
                        android:textColor="#C4C4CE"
                        android:textSize="14sp" />

                    <!-- General Statistics -->
                    <LinearLayout
                        android:id="@+id/sectionGeneralStatistics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp" />

                    <!-- Character Analysis -->
                    <LinearLayout
                        android:id="@+id/sectionCharacterAnalysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp" />

                    <!-- Content Analysis -->
                    <LinearLayout
                        android:id="@+id/sectionContentAnalysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp" />

                    <!-- Encoding Details -->
                    <LinearLayout
                        android:id="@+id/sectionEncodingDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp" />

                    <!-- Generation Details -->
                    <LinearLayout
                        android:id="@+id/sectionGenerationDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
