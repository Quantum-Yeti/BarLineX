<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Barcode content -->
    <TextView
        android:id="@+id/textBarcodeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Example barcode content"
        android:textColor="#F4F6FF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Format and date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/textBarcodeFormat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_format_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="QR_CODE"
            android:textColor="#A9BDFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textBarcodeDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginStart="8dp"
            android:text="Oct 28, 2026, 12:00 PM"
            android:textColor="#8793AD"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="14dp">

        <ImageButton
            android:id="@+id/buttonDeleteBarcode"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete saved barcode"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete" />


    </LinearLayout>

</LinearLayout>
